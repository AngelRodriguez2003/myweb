---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	alt: string;
	/** Rendered width hint for responsive srcset, e.g. "(max-width: 719px) 30vw, 290px". */
	sizes: string;
	class?: string;
	loading?: 'eager' | 'lazy';
}

const { image, alt, sizes, class: className, loading = 'lazy' } = Astro.props;
---

<div class:list={['phone', className]}>
	<div class="phone__body">
		<Image src={image} alt={alt} widths={[200, 320, 480, 780]} sizes={sizes} loading={loading} />
	</div>
</div>

<style>
	.phone {
		container-type: inline-size;
	}

	/* Bezel and corners scale with the frame width (~5px bezel at 150px, ~9px at 340px). */
	.phone__body {
		padding: max(4px, 2.6cqi);
		border-radius: 17cqi;
		background: var(--w-frame);
	}

	.phone img {
		width: 100%;
		height: auto;
		aspect-ratio: 390 / 844;
		object-fit: cover;
		object-position: top;
		border-radius: 14.5cqi;
	}
</style>
