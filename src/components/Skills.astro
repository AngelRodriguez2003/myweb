---
import { useTranslations, type Lang } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

interface Props {
	lang: Lang;
}

const t = useTranslations(Astro.props.lang).skills;
---

<section id="habilidades" class="container section skills" aria-labelledby="skills-title">
	<SectionHeading id="skills-title" label={t.label} title={t.title} />
	<div class="skills__grid">
		{
			t.groups.map((group, i) => (
				<div class="skill-card" data-reveal style={`--i:${Math.min(i + 1, 5)}`}>
					<h3 class="skill-card__title">{group.name}</h3>
					<ul class="skill-card__chips">
						{group.items.map((item) => (
							<li class="chip">{item}</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	.skills {
		display: flex;
		flex-direction: column;
		gap: var(--gap-grid);
	}

	.skills__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
	}

	.skill-card {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 24px;
		border-radius: var(--radius-md);
		background: var(--surface);
		border: 1px solid var(--line-2);
	}

	.skill-card__title {
		font-family: var(--font-display-stack);
		font-weight: 700;
		font-size: 20px;
		line-height: 1.2;
	}

	.skill-card__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding: 0;
		list-style: none;
	}

	@media (max-width: 1199px) {
		.skills__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 719px) {
		.skills__grid {
			grid-template-columns: 1fr;
			gap: 14px;
		}

		.skill-card {
			gap: 16px;
			padding: 20px;
			border-radius: 16px;
		}

		.skill-card__title {
			font-size: 18px;
		}
	}
</style>
