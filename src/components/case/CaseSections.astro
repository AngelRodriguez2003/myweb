---
// Body of the Project Explosive case study: problem, steps, features and stack, technical decisions, gallery and closing CTA.
import { Image } from 'astro:assets';
import { explosive } from '../../data/explosive';
import { routes, useTranslations, type Lang } from '../../i18n/utils';
import PhoneFrame from '../devices/PhoneFrame.astro';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);
const t = dict.case;
const screens = dict.explosive.screens;
---

<section class="container section case-problem" aria-labelledby="problem-title">
	<div class="case-problem__heading" data-reveal>
		<span class="section-label">{t.problem.label}</span>
		<h2 class="section-title" id="problem-title">{t.problem.title[0]}<br />{t.problem.title[1]}</h2>
	</div>
	<div class="case-problem__body">
		{t.problem.paragraphs.map((paragraph, i) => <p data-reveal style={`--i:${Math.min(i + 1, 5)}`}>{paragraph}</p>)}
	</div>
</section>

<section class="container section case-steps" aria-labelledby="steps-title">
	<SectionHeading id="steps-title" label={t.steps.label} title={t.steps.title} />
	<ol class="case-steps__grid">
		{
			t.steps.items.map((step, i) => (
				<li class="step" data-reveal style={`--i:${Math.min(i + 1, 5)}`}>
					<div class="step__media">
						<PhoneFrame class="step__phone" image={explosive.steps[i]} alt={step.alt} sizes="(max-width: 719px) 60vw, 262px" />
					</div>
					<div class="step__text">
						<span class="step__label">{step.step}</span>
						<h3 class="step__title">{step.title}</h3>
						<p class="step__body">{step.body}</p>
					</div>
				</li>
			))
		}
	</ol>
</section>

<section class="container section case-features" aria-labelledby="features-title">
	<SectionHeading id="features-title" label={t.features.label} title={t.features.title} />
	<div class="case-tech__grid">
		{
			t.features.items.map((item, i) => (
				<div class="tech-card" data-reveal style={`--i:${Math.min(i + 1, 5)}`}>
					<span class="tech-card__tag">{item.tag}</span>
					<h3 class="tech-card__title">{item.title}</h3>
					<p class="tech-card__body">{item.body}</p>
				</div>
			))
		}
	</div>

	<div class="demos">
		<div class="demos__head" data-reveal>
			<h3 class="demos__title">{t.features.demos.title}</h3>
			<p class="demos__note">{t.features.demos.note}</p>
		</div>
		<ul class="demos__list">
			{
				explosive.demos.map((item, i) => (
					<li data-reveal style={`--i:${Math.min(i + 1, 5)}`}>
						<figure class="demo">
							<picture>
								<source srcset={item.still} media="(prefers-reduced-motion: reduce)" type="image/webp" />
								<img
									src={item.src}
									alt={t.features.demos.items[item.id].alt}
									width="300"
									height="652"
									loading="lazy"
									decoding="async"
								/>
							</picture>
							<figcaption>{t.features.demos.items[item.id].caption}</figcaption>
						</figure>
					</li>
				))
			}
		</ul>
	</div>

	<div class="stack" data-reveal>
		<h3 class="stack__title">{t.features.stack.title}</h3>
		<dl class="stack__groups">
			{
				t.features.stack.groups.map((group) => (
					<div class="stack__group">
						<dt>{group.name}</dt>
						<dd>
							<ul class="stack__items">
								{group.items.map((item) => <li class="chip">{item}</li>)}
							</ul>
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<section class="case-tech" aria-labelledby="tech-title">
	<div class="container section case-tech__inner">
		<SectionHeading id="tech-title" label={t.tech.label} title={t.tech.title} />
		<div class="case-tech__grid">
			{
				t.tech.items.map((item, i) => (
					<div class="tech-card" data-reveal style={`--i:${Math.min(i + 1, 5)}`}>
						<h3 class="tech-card__title">{item.title}</h3>
						<p class="tech-card__body">{item.body}</p>
					</div>
				))
			}
		</div>

		<div class="ci" data-reveal>
			<div class="ci__bar">
				<span class="ci__title">{t.tech.terminal.title}</span>
				<span class="ci__tag">.github/workflows</span>
			</div>
			<div class="ci__cols">
				{
					t.tech.terminal.columns.map((col) => (
						<div class="ci__col">
							<span class="ci__file">
								{col.file} · {col.when}
							</span>
							{col.lines.map((line) => (
								<span>
									<span class="ci__ok" aria-hidden="true">✓</span> {line}
								</span>
							))}
							{col.last && (
								<span>
									<span class="ci__arrow" aria-hidden="true">→</span> {col.last}
								</span>
							)}
							{'note' in col && col.note && <span class="ci__note">{col.note}</span>}
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<section class="container section case-gallery" aria-labelledby="gallery-title">
	<SectionHeading id="gallery-title" label={t.gallery.label} title={t.gallery.title} />
	{
		[
			{ label: t.gallery.dark, shots: explosive.galleryDark, suffix: '' },
			{ label: t.gallery.light, shots: explosive.galleryLight, suffix: ` ${t.gallery.lightSuffix}` },
		].map((group) => (
			<div class="gallery-group">
				<h3 class="gallery-group__label" data-reveal>{group.label}</h3>
				<div class="gallery-group__grid">
					{group.shots.map((shot, i) => (
						<figure class="shot" data-reveal style={`--i:${Math.min(i, 5)}`}>
							<Image
								src={shot.image}
								alt={`${screens[shot.id].title}${group.suffix}`}
								widths={[240, 400, 600]}
								sizes="(max-width: 719px) 45vw, (max-width: 1023px) 22vw, 160px"
							/>
							<figcaption>{screens[shot.id].title}</figcaption>
						</figure>
					))}
				</div>
			</div>
		))
	}
</section>

<section class="container case-cta-wrap">
	<div class="case-cta" data-reveal>
		<h2 class="case-cta__title">{t.cta.title}</h2>
		<p class="case-cta__body">{t.cta.body}</p>
		<div class="case-cta__actions">
			<a class="btn btn--primary" href={explosive.liveUrl} rel="noopener" target="_blank">
				{t.cta.open}<Icon name="arrow-up-right" size={16} />
			</a>
			<a class="btn btn--ghost" href={routes.home[lang]}>{t.cta.back}</a>
		</div>
	</div>
</section>

<style>
	/* 01 problem */
	.case-problem {
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 56px;
		padding-top: clamp(48px, 30px + 4.6vw, 96px);
	}

	.case-problem__heading {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.case-problem__body {
		display: flex;
		flex-direction: column;
		gap: 22px;
		padding-top: 32px;
		font-size: var(--fs-body);
		line-height: 1.65;
		color: var(--text-2);
	}

	/* 02 steps */
	.case-steps {
		display: flex;
		flex-direction: column;
		gap: var(--gap-grid);
	}

	.case-steps__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		padding: 0;
		list-style: none;
	}

	.step {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: 28px;
		border-radius: 24px;
		background: var(--w-surface);
		border: 1px solid var(--w-line);
	}

	.step__media {
		display: flex;
		justify-content: center;
	}

	.step__media :global(.step__phone) {
		width: min(262px, 100%);
	}

	.step__text {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.step__label {
		font-family: var(--font-mono-stack);
		font-size: 12px;
		color: var(--accent-ink);
	}

	.step__title {
		font-family: var(--font-display-stack);
		font-weight: 700;
		font-size: var(--fs-h4);
	}

	.step__body {
		font-size: 16px;
		line-height: 1.6;
		color: var(--text-2);
	}

	/* 03 features and stack */
	.case-features {
		display: flex;
		flex-direction: column;
		gap: var(--gap-grid);
	}

	.tech-card__tag {
		font-family: var(--font-mono-stack);
		font-size: 12px;
		color: var(--accent-ink);
	}

	.demos {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.demos__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px 24px;
	}

	.demos__title {
		font-family: var(--font-display-stack);
		font-weight: 700;
		font-size: 20px;
	}

	.demos__note {
		font-size: 14px;
		color: var(--muted);
	}

	.demos__list {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 20px;
		padding: 0;
		list-style: none;
	}

	.demo {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.demo img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 22px;
		border: 1px solid var(--w-line);
		background: var(--w-surface);
	}

	.demo figcaption {
		font-size: 14px;
		color: var(--text-2);
	}

	.stack {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 28px;
		border-radius: 20px;
		background: var(--w-surface);
		border: 1px solid var(--w-line);
	}

	.stack__title {
		font-family: var(--font-display-stack);
		font-weight: 700;
		font-size: 20px;
	}

	.stack__groups {
		display: flex;
		flex-direction: column;
	}

	.stack__group {
		display: grid;
		grid-template-columns: 180px 1fr;
		gap: 16px;
		align-items: center;
		padding-block: 14px;
		border-top: 1px solid var(--w-line);
	}

	.stack__group dt {
		font-family: var(--font-mono-stack);
		font-size: 13px;
		color: var(--muted);
	}

	.stack__items {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding: 0;
		list-style: none;
	}

	/* 04 technical decisions */
	.case-tech {
		background: var(--w-band);
		border-block: 1px solid var(--w-line);
	}

	.case-tech__inner {
		display: flex;
		flex-direction: column;
		gap: var(--gap-grid);
	}

	.case-tech__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
	}

	.tech-card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 28px;
		border-radius: 20px;
		background: var(--w-surface);
		border: 1px solid var(--w-line);
	}

	.tech-card__title {
		font-family: var(--font-display-stack);
		font-weight: 700;
		font-size: 20px;
		line-height: 1.2;
	}

	.tech-card__body {
		font-size: 16px;
		line-height: 1.6;
		color: var(--text-2);
	}

	/* The CI terminal stays dark in both themes. */
	.ci {
		border-radius: 20px;
		background: #0b0908;
		border: 1px solid #2c2521;
		color: #f6f1eb;
		overflow: hidden;
	}

	.ci__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 28px;
		border-bottom: 1px solid #2c2521;
	}

	.ci__title {
		font-family: var(--font-display-stack);
		font-weight: 700;
		font-size: 17px;
	}

	.ci__tag {
		font-family: var(--font-mono-stack);
		font-size: 12px;
		color: #a79c92;
	}

	.ci__cols {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
		padding: 28px;
		font-family: var(--font-mono-stack);
		font-size: 14px;
		line-height: 1.9;
	}

	.ci__col {
		display: flex;
		flex-direction: column;
	}

	.ci__file,
	.ci__note {
		color: #a79c92;
	}

	.ci__ok {
		color: #4fbf8b;
		margin-right: 0.5em;
	}

	.ci__arrow {
		color: #e2703f;
		margin-right: 0.5em;
	}

	/* 05 gallery */
	.case-gallery {
		display: flex;
		flex-direction: column;
		gap: var(--gap-grid);
	}

	.gallery-group {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.gallery-group__label {
		font-family: var(--font-mono-stack);
		font-weight: 400;
		font-size: 12px;
		color: var(--muted);
	}

	.gallery-group__grid {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 16px;
	}

	.shot {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.shot :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 390 / 844;
		object-fit: cover;
		object-position: top;
		border-radius: 18px;
		border: 1px solid var(--w-line);
	}

	.shot figcaption {
		font-size: 14px;
		color: var(--text-2);
	}

	/* Closing CTA */
	.case-cta-wrap {
		padding-bottom: var(--section-y);
	}

	.case-cta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
		padding: clamp(32px, 21px + 2.9vw, 56px) clamp(24px, 16.6px + 1.9vw, 44px);
		border-radius: var(--radius-xl);
		background: var(--w-surface);
		border: 1px solid var(--w-line);
	}

	.case-cta__title {
		font-family: var(--font-display-stack);
		font-weight: 800;
		font-size: clamp(2rem, 1.536rem + 1.905vw, 3.25rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.case-cta__body {
		max-width: 620px;
		font-size: var(--fs-lead);
		line-height: 1.55;
		color: var(--text-2);
	}

	.case-cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	@media (max-width: 1023px) {
		.case-problem {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		.case-problem__body {
			padding-top: 0;
		}

		.case-steps__grid,
		.case-tech__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.ci__cols {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.demos__list {
			grid-template-columns: none;
			grid-auto-flow: column;
			grid-auto-columns: 30%;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			padding-bottom: 8px;
		}

		.demos__list > li {
			scroll-snap-align: start;
		}

		.gallery-group__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (max-width: 719px) {
		.case-steps__grid,
		.case-tech__grid {
			grid-template-columns: 1fr;
		}

		.step {
			padding: 24px 20px;
		}

		.tech-card {
			padding: 22px 20px;
		}

		.stack {
			padding: 22px 20px;
		}

		.demos__list {
			grid-auto-columns: 62%;
			gap: 14px;
		}

		.demo img {
			border-radius: 18px;
		}

		.stack__group {
			grid-template-columns: 1fr;
			gap: 10px;
		}

		.ci__bar,
		.ci__cols {
			padding-inline: 20px;
		}

		.ci__cols {
			font-size: 12px;
		}

		.gallery-group__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 12px;
		}

		.shot :global(img) {
			border-radius: 14px;
		}

		.case-cta__actions {
			flex-direction: column;
			align-self: stretch;
		}
	}
</style>
