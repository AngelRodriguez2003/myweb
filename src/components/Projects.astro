---
import { useTranslations, type Lang } from '../i18n/utils';
import ProjectCard from './ProjectCard.astro';
import ProjectModal from './ProjectModal.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).projects;
const modalId = 'explosive-modal';
---

<section id="proyectos" class="container section projects" aria-labelledby="projects-title">
	<SectionHeading id="projects-title" label={t.label} title={t.title} />
	<div class="projects__grid">
		<ProjectCard lang={lang} modalId={modalId} />
		<article class="projects__next">
			<h3 class="projects__next-title">{t.nextTitle}</h3>
			<p class="projects__next-body">{t.nextBody}</p>
		</article>
	</div>
	<ProjectModal lang={lang} id={modalId} />
</section>

<style>
	.projects {
		display: flex;
		flex-direction: column;
		gap: var(--gap-grid);
	}

	.projects__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
	}

	.projects__next {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 40px 24px;
		border-radius: var(--radius-lg);
		border: 1px dashed var(--line-dash-2);
		text-align: center;
	}

	.projects__next-title {
		font-family: var(--font-display-stack);
		font-weight: 700;
		font-size: 20px;
	}

	.projects__next-body {
		font-size: 15px;
		color: var(--muted);
	}

	@media (max-width: 1023px) {
		.projects__grid {
			grid-template-columns: 1fr;
			gap: 16px;
		}
	}
</style>
